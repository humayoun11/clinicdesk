{
  "openapi": "3.0.3",
  "info": {
    "title": "ClinicDesk REST API",
    "version": "1.0.0",
    "description": "Single-clinic fictional demo. UTC storage; display timezone configurable. Sanctum opaque bearer tokens expire explicitly and are revoked by logout. Website and API share policies and BookingService. Patient manages own bookings; doctor reads assigned appointments; admin reads and manages bookings. Terminal statuses are final. Password reset and profile management are browser routes. Login: 5 requests/min per email+IP and 30/min per IP. Registration: 5/min/IP. API: 60/min/IP. Business conflicts use 422 with field errors."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000/api/v1",
      "description": "Local development; use HTTPS in production"
    }
  ],
